{
  "name": "@edkimmel/faro-react-native",
  "version": "1.0.0",
  "description": "Faro SDK for React Native - bridges JavaScript with native Android/iOS Faro SDKs",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "scripts": {
    "build": "bob build",
    "typescript": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "edkimmel",
    "faro",
    "observability",
    "monitoring",
    "logging",
    "error-tracking"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.3.0"
  },
  "codegenConfig": {
    "name": "FaroReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.grafana.faro.reactnative"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
